[Unit]
Description=Kalshi KXHIGHNY market data logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/kalshi-weather
EnvironmentFile=-%h/kalshi-weather/.env
ExecStart=%h/kalshi-weather/.venv/bin/python -m ingestion.kalshi_logger
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
