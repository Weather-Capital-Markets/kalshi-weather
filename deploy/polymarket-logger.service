[Unit]
Description=Polymarket US NYC temperature market data logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/kalshi-weather
EnvironmentFile=-%h/kalshi-weather/.env
ExecStart=%h/kalshi-weather/.venv/bin/python -m ingestion.polymarket_logger
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
